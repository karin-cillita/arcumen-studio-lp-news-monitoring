---

<section id="pricing" class="py-24 px-8 bg-ivory">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display font-bold text-navy mb-4">
        Simple pricing. No per-seat fees, no annual lock-in.
      </h2>
      <p class="text-lg text-stone max-w-2xl mx-auto">
        Every tier includes a free 1-week trial — your first briefs delivered within 24 hours, no payment required.
      </p>
    </div>

    <!-- Pricing Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Starter -->
      <div class="bg-white border border-stone/20 p-8 flex flex-col">
        <p class="text-sm uppercase tracking-wider text-stone mb-2">Starter</p>
        <p class="text-3xl font-display font-bold text-navy mb-1">
          <span class="text-gold">€500</span>/month
        </p>
        <p class="text-sm text-stone mb-6">1–5 portfolio companies</p>
        <p class="text-base text-charcoal leading-relaxed mb-6">
          Daily brief delivered to your inbox — every article reviewed by a human before it reaches you. Covers Funding, M&A, Leadership changes, and Regulatory signals across your watchlist.
        </p>
        <p class="text-sm text-stone italic mt-auto">
          Best for: solo GPs, small family offices, or teams testing the service on a single fund.
        </p>
      </div>

      <!-- Professional -->
      <div class="bg-white border-2 border-gold p-8 flex flex-col relative">
        <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-gold text-ivory text-xs font-semibold uppercase tracking-wider px-4 py-1">
          Most Popular
        </span>
        <p class="text-sm uppercase tracking-wider text-stone mb-2">Professional</p>
        <p class="text-3xl font-display font-bold text-navy mb-1">
          <span class="text-gold">€750–1,000</span>/month
        </p>
        <p class="text-sm text-stone mb-6">10–20 portfolio companies</p>
        <p class="text-base text-charcoal leading-relaxed mb-6">
          Everything in Starter, scaled to a full portfolio. Priority support — watchlist changes processed same day, direct line to your monitoring analyst.
        </p>
        <p class="text-sm text-stone italic mt-auto">
          Best for: PE funds with active portfolios, strategy consultants covering multiple sectors.
        </p>
      </div>

      <!-- Custom -->
      <div class="bg-white border border-stone/20 p-8 flex flex-col">
        <p class="text-sm uppercase tracking-wider text-stone mb-2">Custom</p>
        <p class="text-3xl font-display font-bold text-navy mb-1">
          from <span class="text-gold">€1,500</span>/month
        </p>
        <p class="text-sm text-stone mb-6">20+ companies, tailored coverage</p>
        <p class="text-base text-charcoal leading-relaxed mb-6">
          Custom monitoring categories beyond the standard four. Weekly strategy calls to discuss signals and adjust coverage. Built around how your team actually uses intelligence.
        </p>
        <p class="text-sm text-stone italic mt-auto">
          Best for: multi-fund offices, investment banks, or firms with specific sector or regulatory needs.
        </p>
      </div>

    </div>
  </div>
</section>
